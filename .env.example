# ==============================================================================
# Sterling — Environment Variables
# Copy this file to .env.local:
#   cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Inference Provider ('fireworks' | 'openai')
# ------------------------------------------------------------------------------
INFERENCE_PROVIDER=fireworks

# --- Fireworks AI (Default Provider) ---
# Get your API key from: https://fireworks.ai/api-keys
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
# Reasoning effort for thinking models: 'low' | 'medium' | 'high' | 'max' (Default: 'low')
FIREWORKS_REASONING_EFFORT=low

# --- OpenAI (Optional / Backup Provider) ---
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ------------------------------------------------------------------------------
# 2. Neural Search & Live Research (Exa AI)
# ------------------------------------------------------------------------------
# Used for real-time web search, document retrieval, and breaking news briefings.
# Get your API key from: https://dashboard.exa.ai/api-keys
EXA_API_KEY=